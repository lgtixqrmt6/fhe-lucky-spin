{
  "name": "luckyspin",
  "version": "1.0.0",
  "description": "LuckySpin - FHE-powered encrypted spin wheel platform with privacy-preserving draws",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:simple": "hardhat run scripts/deploy-simple.js --network sepolia",
    "test": "hardhat test",
    "test:simple": "hardhat test test/SimpleFHELuckySpin.test.js",
    "test:spin": "hardhat test test/SpinManager.test.js",
    "test:prize": "hardhat test test/PrizeManager.test.js",
    "test:reward": "hardhat test test/RewardDistributor.test.js",
    "test:user": "hardhat test test/UserRecords.test.js",
    "test:v2": "hardhat test test/FHELuckySpinV2.test.js",
    "test:all": "hardhat test test/*.test.js",
